{
  "name": "ultimate-esports-manager",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --configLoader native",
    "test": "node --test tests/*.test.ts",
    "verify:build": "node tools/verify-build.mjs",
    "preview": "vite preview --configLoader native --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.51.0-build1",
    "html-to-image": "1.11.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
